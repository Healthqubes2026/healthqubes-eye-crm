{
  "name": "healthqube-eyes",
  "version": "1.0.0",
  "description": "Healthqube Eyes — Smart Eye Care FieldForce & Sales Tracking System",
  "private": true,
  "workspaces": [
    "backend",
    "admin",
    "mobile"
  ],
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../admin && npm install && cd ../mobile && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:admin": "cd admin && npm start",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:admin\"",
    "build:admin": "cd admin && npm run build",
    "migrate": "cd backend && npm run migrate",
    "seed": "cd backend && npm run seed",
    "deploy": "chmod +x deploy/scripts/deploy.sh && sudo ./deploy/scripts/deploy.sh",
    "update": "chmod +x deploy/scripts/update.sh && sudo ./deploy/scripts/update.sh",
    "health": "chmod +x deploy/scripts/health.sh && ./deploy/scripts/health.sh",
    "backup": "chmod +x deploy/scripts/db.sh && ./deploy/scripts/db.sh backup"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "ajv": "^8.12.0"
  }
}
