# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ─── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hommacare_eye

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP ──────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
# SMS provider (twilio / msg91 / fast2sms)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=HMCARE
MSG91_TEMPLATE_ID=your_template_id

# ─── File Upload ──────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10

# ─── Email Configuration ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=Hommacare Eye
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ─── WhatsApp Integration (Twilio) ─────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ─── Firebase Push Notifications ─────────────────────────
FIREBASE_PROJECT_ID=hommacare-eye
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@hommacare-eye.iam.gserviceaccount.com

# ─── Google Maps ──────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Frontend URL (CORS) ──────────────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3001

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
